# ============================================================
# ZN-M2 极简旁路由固件配置 (256MB RAM / NO WiFi / 25.12-nss)
# ============================================================
# 目标: 最小依赖 + 可持续按版本更新 + 软件后续按需 apk add 安装
# 源码: LiBwrt openwrt-6.x / 25.12-nss (内核 6.12 + NSS 硬件加速)
# 包管理器: apk (OpenWrt 25.12 起用 apk, 不再是 opkg)
#
# !! 关键: 内存档位必须 256MB。上游 mini.config 是 1024(1G改装机),
# !! 直接用于原厂 256MB 的 ZN-M2 会起不来/反复重启。
# !! 本文件已改为 256MB 档 + NSS LOW + ATH11K 256M。
#
# 用法: 在 fork 仓库把本文件放到 configs/,
#       并把 mini.yml 的 CONFIG_FILE 指向 configs/zn-m2-ultra-minimal.config
# ============================================================

# ---- 目标设备 ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ---- 内存档位 (关键! 256MB) ----
CONFIG_IPQ_MEM_PROFILE_256=y
# CONFIG_IPQ_MEM_PROFILE_512 is not set
# CONFIG_IPQ_MEM_PROFILE_1024 is not set
CONFIG_KERNEL_IPQ_MEM_PROFILE=256
CONFIG_NSS_MEM_PROFILE_LOW=y
# CONFIG_NSS_MEM_PROFILE_MEDIUM is not set
CONFIG_ATH11K_MEM_PROFILE_256M=y
# CONFIG_ATH11K_MEM_PROFILE_512M is not set
# CONFIG_ATH11K_MEM_PROFILE_1G is not set

# ---- zram swap: 开机自带交换区 (解决原系统 swap=0) ----
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZORLE=y
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ---- NSS 硬件加速 (保留, 旁路由转发性能) ----
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
# CONFIG_NSS_FIRMWARE_VERSION_12_5 is not set
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_L2TP_ENABLE=y
CONFIG_NSS_DRV_LAG_ENABLE=y
CONFIG_NSS_DRV_MAPT_ENABLE=y
CONFIG_NSS_DRV_PPTP_ENABLE=y
CONFIG_NSS_DRV_PVXLAN_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_VXLAN_ENABLE=y

# ---- 中文语言 ----
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 最小 LuCI (仅基础管理, 无多余主题/插件) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_ucode-mod-math=y

# ---- 后续 apk add 所需的包管理基础 (保留!) ----
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libopenssl-conf=y

# ---- 核心网络 (精简) ----
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_xtables-nft=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-sit=y
CONFIG_PACKAGE_ipset=y

# ---- 保留少量常用工具 (后续装 PassWall 会用到) ----
CONFIG_PACKAGE_tcping=y

# ============================================================
# 以下为刻意 NOT set 的冗余项 (极简核心)
# PassWall/Xray 等后续按需 apk add / LuCI 装, 不预置
# ============================================================
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2socks is not set
# CONFIG_PACKAGE_ipt2socks is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_geoview is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set
# CONFIG_PACKAGE_https-dns-proxy is not set
# CONFIG_PACKAGE_luci-app-https-dns-proxy is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set
# CONFIG_PACKAGE_ttyd is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn is not set
# --- 主题/插件冗余 ---
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_wsdd2 is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_kmod-wireguard is not set
# --- 测试/跑分工具冗余 ---
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_iperf3 is not set
# CONFIG_PACKAGE_libiperf3 is not set
# CONFIG_PACKAGE_stress-ng is not set
# --- USB/WiFi (旁路由不需要, 且省内存) ---
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-phy-msm is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# ---- BusyBox 保留 IPv6 (IPv6 完整支持) ----
CONFIG_BUSYBOX_CONFIG_FEATURE_IPV6=y

# ---- 关闭 initramfs ----
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
